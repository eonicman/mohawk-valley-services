{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mohawk-valley-services",
  "main": "worker.js",
  "compatibility_date": "2026-07-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "STRIPE_PRICE_MONTHLY": "price_1TyXlzQts1c0fveCMjGkwyBc",
    "STRIPE_PRICE_ANNUAL": "price_1TyXlzQts1c0fveCaU3g75jU"
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/category/*", "/guides/*"]
  },
  "d1_databases": [
    {
      "binding": "LEADS",
      "database_name": "directory-leads",
      "database_id": "6e62cee1-81ba-4d35-917e-708087500877"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
